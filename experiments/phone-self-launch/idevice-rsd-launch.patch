+    /// Runs through a caller-owned authenticated RSD tunnel. No lockdown,
+    /// usbmuxd, CoreDeviceProxy, or external host is contacted by this entry.
+    /// The caller must hold the RemotePairing control connection until completion.
+    pub async fn run_from_rsd<L: XCUITestListener>(
+        cfg: TestConfig,
+        listener: &mut L,
+        timeout: Option<std::time::Duration>,
+        ios_major_version: u8,
+        mut handle: crate::tcp::handle::AdapterHandle,
+        handshake: RsdHandshake,
+    ) -> Result<(), IdeviceError> {
+        if ios_major_version < 17 {
+            return Err(IdeviceError::UnexpectedResponse("RSD requires iOS 17+".into()));
+        }
+        let dvt = rsd_connect(&mut handle, &handshake,
+            "com.apple.instruments.dtservicehub", "dtservicehub", true).await?;
+        let ctrl = rsd_connect(&mut handle, &handshake,
+            TESTMANAGERD_RSD_SERVICE, "testmanagerd-ctrl", false).await?;
+        let main = rsd_connect(&mut handle, &handshake,
+            TESTMANAGERD_RSD_SERVICE, "testmanagerd-main", false).await?;
+        let conns = TestManagerConnections { ctrl, main, dvt, rsd_handles: vec![handle] };
+        let session_id = uuid::Uuid::new_v4();
+        let xctest_path = format!("/tmp/{}.xctestconfiguration", session_id.to_string().to_uppercase());
+        Self::run_connections(cfg, listener, timeout, ios_major_version, session_id, xctest_path, conns).await
+    }
